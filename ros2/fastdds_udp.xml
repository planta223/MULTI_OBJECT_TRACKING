<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS 2.1.x/2.6.x와 호환되는 UDPv4 전용 participant profile.

  현재 host-network/host-IPC 배포 환경의 ROS2 Foxy subscriber에 필요한
  profile이다. host publisher는 UID 1000으로 실행하지만 container workload는
  일반적으로 root로 실행한다. 서로 다른 사용자 사이에서 기본 SHM 통신이
  실패했으며, UID-1000 container probe와 UDP 전용 transport 모두 전송을
  복구했다. UDP 전용 설정은 container 실행 사용자를 바꾸지 않으면서 작은
  message와 압축 ZED stream을 모두 전달한다.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>pipe_align_udp_v4</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="pipe_align_udp_only" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>pipe_align_udp_v4</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
